# ================================================================
#  WISPCONTROL — .env de producción (cPanel)
#  Copia este archivo como .env en la carpeta wispcontrol/ del servidor.
# ================================================================
APP_NAME=WISPCONTROL
APP_ENV=production
APP_DEBUG=false
# Genera una clave: en local ejecuta  php artisan key:generate --show  y pégala aquí
APP_KEY=
APP_URL=https://tudominio.com
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

# Instalador web: true solo durante la instalación (https://tudominio.com/install)
INSTALLER_ENABLED=true

# Enlace "Agenda una demo" en el login (ej. https://wa.me/524421234567). Vacío = no se muestra.
WISP_SALES_URL=

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base de datos MySQL 5.7 creada en cPanel > Bases de datos MySQL
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=usuario_wispcontrol
DB_USERNAME=usuario_wisp
DB_PASSWORD=

# Sin Redis en hosting compartido: todo en base de datos
SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Correo (cuenta de correo creada en cPanel)
MAIL_MAILER=smtp
MAIL_HOST=mail.tudominio.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=notificaciones@tudominio.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notificaciones@tudominio.com
MAIL_FROM_NAME="${APP_NAME}"

# Credenciales del superadmin si se instala por consola (php artisan db:seed --class=ProductionSeeder)
SUPERADMIN_EMAIL=superadmin@tudominio.com
SUPERADMIN_PASSWORD=
