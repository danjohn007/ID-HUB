<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ventana mientras arranca el proceso: navy de la marca (sin destello blanco). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/splash_navy</item>
        <item name="android:navigationBarColor">@color/splash_navy</item>
    </style>
    <!-- Fondo detrás de la UI de Flutter mientras corre. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_navy</item>
    </style>
</resources>